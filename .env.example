# =====================================================
# CONFIGURAÇÃO DO BANCO DE DADOS
# =====================================================
# Copie este arquivo para .env e ajuste as credenciais

# Host do banco de dados
# - Use 'localhost' se MySQL estiver na mesma máquina
# - Use 'host.docker.internal' se usar Docker no Windows/Mac
# - Use '127.0.0.1' para conexão TCP local
DB_HOST=host.docker.internal

# Porta do MySQL (padrão: 3306)
DB_PORT=3306

# Nome do banco de dados
# IMPORTANTE: Crie o banco antes: CREATE DATABASE alphacode_db;
DB_NAME=alphacode_db

# Usuário do MySQL
# IMPORTANTE: Nunca use 'root' em produção!
DB_USER=root

# Senha do MySQL
# IMPORTANTE: Use senha forte em produção e não commite no Git!
DB_PASSWORD=sua_senha_aqui

# =====================================================
# INSTRUÇÕES DE USO
# =====================================================
# 1. Copie este arquivo: cp .env.example .env
# 2. Edite o .env com suas credenciais reais
# 3. Execute a migration: mysql -u root -p alphacode_db < database/migration.sql
# 4. Inicie o projeto: docker-compose up -d
#
# Documentação completa: database/DATABASE_SETUP.md
# =====================================================
