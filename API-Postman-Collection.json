{
  "info": {
    "name": "API REST - TestePHP",
    "description": "Collection completa da API REST para gerenciamento de Clientes, Produtos e Pedidos",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "1"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('token', jsonData.data.token);",
                  "    pm.environment.set('token', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"seu@email.com\",\n  \"senha\": \"suasenha\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Realiza login e retorna token de autenticação"
          },
          "response": []
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Retorna dados do usuário autenticado"
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Realiza logout e invalida o token"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Listar Clientes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/clientes?page=1&per_page=20&order_by=ID_CLIENTE&order_dir=ASC",
              "host": ["{{base_url}}"],
              "path": ["clientes"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "20"
                },
                {
                  "key": "nome",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "cpf",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "email",
                  "value": "",
                  "disabled": true
                },
                {
                  "key": "order_by",
                  "value": "ID_CLIENTE"
                },
                {
                  "key": "order_dir",
                  "value": "ASC"
                }
              ]
            },
            "description": "Lista todos os clientes com paginação e filtros opcionais"
          },
          "response": []
        },
        {
          "name": "Buscar Cliente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/clientes/1",
              "host": ["{{base_url}}"],
              "path": ["clientes", "1"]
            },
            "description": "Busca um cliente específico por ID"
          },
          "response": []
        },
        {
          "name": "Criar Cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João da Silva\",\n  \"cpf\": \"12345678901\",\n  \"email\": \"joao@example.com\",\n  \"telefone\": \"11987654321\",\n  \"endereco\": \"Rua A, 123, Centro\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/clientes",
              "host": ["{{base_url}}"],
              "path": ["clientes"]
            },
            "description": "Cria um novo cliente"
          },
          "response": []
        },
        {
          "name": "Atualizar Cliente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"João da Silva Santos\",\n  \"cpf\": \"12345678901\",\n  \"email\": \"joao.novo@example.com\",\n  \"telefone\": \"11987654321\",\n  \"endereco\": \"Rua A, 123, Centro - Atualizado\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/clientes/1",
              "host": ["{{base_url}}"],
              "path": ["clientes", "1"]
            },
            "description": "Atualiza dados de um cliente existente"
          },
          "response": []
        },
        {
          "name": "Deletar Cliente",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/clientes/1",
              "host": ["{{base_url}}"],
              "path": ["clientes", "1"]
            },
            "description": "Deleta um cliente (apenas se não tiver pedidos em aberto ou cancelados)"
          },
          "response": []
        }
      ]
    },
